# MongoDB shared with the old voetbalstages backend
MONGO_URI=mongodb://localhost:27017/administration

# local | staging | production. DEV_TOOLS (fake payments, logged login links) is refused in production.
APP_ENV=local
DEV_TOOLS=false

# Public URLs
API_URL=http://localhost:3000
SHOP_URL=http://localhost:5173
# Comma-separated, exact-match origins allowed to call the API with credentials
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
# Admin panel origin (admin login links). Must also be in CORS_ORIGINS and share the API's registrable domain.
ADMIN_URL=http://localhost:5174

# Number of reverse proxies in front of the app (Traefik on Coolify = 1, + Cloudflare = 2)
TRUSTED_PROXY_COUNT=0

# Mail (AWS SES v2). MAIL_DISABLED=true logs mails instead of sending them.
MAIL_DISABLED=true
MAIL_FROM_FALLBACK="Voetbalstages.be" <thomas@voetbalstages.be>
AWS_SES_REGION=eu-west-1
AWS_SES_USER_KEY=
AWS_SES_USER_SECRET=

# Mollie (OAuth app, same credentials as the old backend)
MOLLIE_CLIENT_ID=
MOLLIE_CLIENT_SECRET=
MOLLIE_REFRESH_TOKEN=
MOLLIE_TESTMODE=true
# Platform fee per registration in EUR
APPLICATION_FEE=0

# Optional
# Logo uploads (S3 bucket voetbalstages, same keys as the old backend)
AWS_S3_USER_KEY=
AWS_S3_USER_SECRET=
# Admin address lookup (Google Places + Geocoding)
GOOGLE_PLACES_API_KEY=
N8N_WEBHOOK_URL=
BUGSNAG_API_KEY=

PORT=3000
LOG_LEVEL=info
